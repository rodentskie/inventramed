# Copy to setup/.env. Docker Compose reads it automatically from this directory.
# Values go into connection URLs, so use letters and digits only
# (e.g. openssl rand -hex 24), or URL-encode them.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=inventramed

# RabbitMQ. The Pi consumer uses the same user in its RABBITMQ_URL.
RABBITMQ_USER=inventramed
RABBITMQ_PASSWORD=inventramed

# App. Set NEXTAUTH_URL to the address people open in the browser,
# e.g. http://192.168.1.10:3000 when used from other machines on the LAN.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_MINUTES=15

# Shared by the app and both workers. Generate with: openssl rand -base64 32
WORKER_API_TOKEN=

# Worker. Wait before the first claim and while no consumer is connected.
WORKER_POLL_INTERVAL=30s

# Host ports
APP_PORT=3000
PG_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
