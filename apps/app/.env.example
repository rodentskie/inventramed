DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventramed?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Bearer token for the SMS worker. Worker calls are rejected while this is empty.
# Generate with: openssl rand -base64 32
WORKER_API_TOKEN=""

# Login attempt limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_MINUTES=15
