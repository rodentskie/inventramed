generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum InventoryDirection {
  IN
  OUT

  @@map("inventory_direction")
}

enum InventoryReason {
  RECEIVED // new stock arrived (IN)
  DISPENSED // normal usage, FIFO-allocated (OUT)
  COUNT_ADJUSTMENT // physical count correction (IN or OUT)
  RETURNED // returned to stock (IN) or returned to supplier (OUT)
  DAMAGED // OUT
  LOST // OUT
  EXPIRED_DISPOSAL // OUT, expired batch removed from stock

  @@map("inventory_reason")
}

enum ExpiryStatus {
  NEAR_EXPIRY
  EXPIRED

  @@map("expiry_status")
}

enum SmsStatus {
  PENDING // queued, waiting to be claimed (or waiting for retry)
  SENDING // claimed by the worker, result not yet reported
  SENT // GSM module accepted the message
  FAILED // gave up after settings.sms_max_attempts
  CANCELLED // no longer relevant (recipient opted out, superseded by a newer digest)

  @@map("sms_status")
}

enum SmsAttemptResult {
  SENT
  FAILED

  @@map("sms_attempt_result")
}

// ─── Access control ─────────────────────────────────────────────────────

model Employee {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName         String    @map("first_name")
  middleName        String?   @map("middle_name")
  lastName          String    @map("last_name")
  email             String?   @unique
  contactNumber     String?   @map("contact_number") // E.164, e.g. +639171234567
  position          String?
  receivesSmsAlerts Boolean   @default(false) @map("receives_sms_alerts")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  user        User?
  smsMessages SmsMessage[]

  @@map("employees")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String    @unique @map("employee_id") @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  employee              Employee               @relation(fields: [employeeId], references: [id])
  role                  Role                   @relation(fields: [roleId], references: [id])
  medicinesCreated      Medicine[]
  inventoryTransactions InventoryTransaction[]
  notificationReads     NotificationRead[]
  settingsUpdated       Setting[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique // admin, staff, collaborator
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // seeded roles, cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String // e.g. "medicine:create", "inventory:*", "*"

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

// ─── Medicine inventory ─────────────────────────────────────────────────

model Medicine {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  genericName String?   @map("generic_name")
  strength    String? // e.g. "500 mg"
  dosageForm  String?   @map("dosage_form") // e.g. "tablet", "syrup"
  unit        String    @default("pc") // unit counted in quantity
  barcode     String    @unique // generated by the app
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy    User?                  @relation(fields: [createdById], references: [id])
  batches      MedicineBatch[]
  transactions InventoryTransaction[]

  @@index([name])
  @@map("medicines")
}

model MedicineBatch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicineId     String   @map("medicine_id") @db.Uuid
  batchNumber    String   @map("batch_number")
  barcode        String   @unique // generated by the app, printed on the batch label
  expirationDate DateTime @map("expiration_date") @db.Date
  quantity       Int      @default(0) // maintained by trigger only, CHECK >= 0
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  medicine          Medicine           @relation(fields: [medicineId], references: [id])
  entries           InventoryEntry[]
  notificationItems NotificationItem[]

  @@unique([medicineId, batchNumber, expirationDate])
  @@index([medicineId, expirationDate, receivedAt]) // FIFO/FEFO allocation order
  @@index([expirationDate]) // expiry scans
  @@map("medicine_batches")
}

// ─── Inventory movement ─────────────────────────────────────────────────

model InventoryTransaction {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicineId    String             @map("medicine_id") @db.Uuid
  direction     InventoryDirection
  reason        InventoryReason
  quantity      Int // total across entries, CHECK > 0
  performedById String             @map("performed_by") @db.Uuid
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  medicine    Medicine         @relation(fields: [medicineId], references: [id])
  performedBy User             @relation(fields: [performedById], references: [id])
  entries     InventoryEntry[]

  @@index([medicineId, createdAt])
  @@map("inventory_transactions")
}

model InventoryEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  quantity      Int // CHECK > 0; sign comes from the transaction's direction
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  transaction InventoryTransaction @relation(fields: [transactionId], references: [id])
  batch       MedicineBatch        @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([transactionId])
  @@map("inventory_entries")
}

// ─── Notifications ──────────────────────────────────────────────────────

model Notification {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationDate DateTime @unique @map("notification_date") @db.Date // local date (settings.timezone)
  expiredCount     Int      @default(0) @map("expired_count")
  nearExpiryCount  Int      @default(0) @map("near_expiry_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  items       NotificationItem[]
  reads       NotificationRead[]
  smsMessages SmsMessage[]

  @@map("notifications")
}

model NotificationItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  batchId        String       @map("batch_id") @db.Uuid
  status         ExpiryStatus
  quantity       Int // snapshot at generation time
  expirationDate DateTime     @map("expiration_date") @db.Date // snapshot
  daysToExpiry   Int          @map("days_to_expiry") // negative = days since expiry

  notification Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  batch        MedicineBatch @relation(fields: [batchId], references: [id])

  @@unique([notificationId, batchId])
  @@index([batchId])
  @@map("notification_items")
}

model NotificationRead {
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_reads")
}

model SmsMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  phoneNumber    String    @map("phone_number") // snapshot at queue time
  body           String // snapshot at queue time
  status         SmsStatus @default(PENDING)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  notification Notification @relation(fields: [notificationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  attemptLogs  SmsAttempt[]

  @@unique([notificationId, employeeId]) // an employee is texted at most once per day
  @@index([status, nextAttemptAt]) // worker claim query
  @@map("sms_messages")
}

model SmsAttempt {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  smsMessageId  String           @map("sms_message_id") @db.Uuid
  attemptNo     Int              @map("attempt_no")
  result        SmsAttemptResult
  error         String?
  modemResponse String?          @map("modem_response") // raw AT response / message ref
  attemptedAt   DateTime         @default(now()) @map("attempted_at") @db.Timestamptz

  smsMessage SmsMessage @relation(fields: [smsMessageId], references: [id], onDelete: Cascade)

  @@unique([smsMessageId, attemptNo])
  @@map("sms_attempts")
}

// ─── Settings ───────────────────────────────────────────────────────────

model Setting {
  id                      Int       @id @default(1) // CHECK (id = 1), single row
  facilityName            String    @default("InventraMed") @map("facility_name") // SMS sender label
  timezone                String    @default("Asia/Manila") // IANA tz (UTC+8) used for "today" in expiry math
  nearExpiryThresholdDays Int       @default(30) @map("near_expiry_threshold_days")
  dailyNotificationTime   String    @default("08:00") @map("daily_notification_time") // HH:mm, local tz
  smsEnabled              Boolean   @default(true) @map("sms_enabled")
  smsMaxAttempts          Int       @default(3) @map("sms_max_attempts")
  smsRetryDelayMinutes    Int       @default(15) @map("sms_retry_delay_minutes")
  smsClaimTimeoutMinutes  Int       @default(10) @map("sms_claim_timeout_minutes")
  smsBatchSize            Int       @default(10) @map("sms_batch_size") // max messages per claim
  smsMaxItems             Int       @default(10) @map("sms_max_items") // items listed before "+N more"
  workerPollIntervalSecs  Int       @default(300) @map("worker_poll_interval_secs")
  smsTemplate             String    @default("{facility} expiry alert {date}: {expired} expired, {near_expiry} near expiry.\n{items}") @map("sms_template")
  workerLastSeenAt        DateTime? @map("worker_last_seen_at") @db.Timestamptz // updated on every worker call
  updatedById             String?   @map("updated_by") @db.Uuid
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

// ─── Audit ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type") // table name
  entityId   String   @map("entity_id") @db.Uuid
  action     String // created | updated | deleted
  changes    Json? // {"before": ..., "after": ...}
  actorId    String?  @map("actor_id") @db.Uuid // from app.actor_id, NULL = system
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
