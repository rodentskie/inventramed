{
  "name": "@inventra-med/app",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/app/src",
    "targets": {
      "prisma:generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma generate"
        }
      },
      "prisma:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false,
          "command": "prisma migrate dev"
        }
      },
      "prisma:migrate:create": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate dev --create-only"
        }
      },
      "prisma:deploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate deploy"
        }
      },
      "prisma:status": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate status"
        }
      },
      "prisma:reset": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate reset"
        }
      },
      "prisma:seed": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma db seed"
        }
      },
      "prisma:validate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma validate"
        }
      },
      "prisma:format": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma format"
        }
      },
      "prisma:studio": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma studio"
        }
      },
      "build": {
        "dependsOn": [
          "prisma:generate",
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "prisma:generate",
          "^build"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma:generate",
          "^build"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false,
          "commands": [
            "next typegen",
            "tsc -p tsconfig.json --noEmit",
            "tsc -p tsconfig.prisma.json"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "next": "~16.4.1",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "~30.0.0",
    "@types/pg": "^8.23.1",
    "jest": "~30.3.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}
